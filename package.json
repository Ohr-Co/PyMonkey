{
  "name": "pymonkey",
  "version": "0.1.0",
  "private": true,
  "description": "A browser extension that runs your Python scripts on the pages you visit.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "test": "node --test tests/*.test.mjs && python3 -m pytest -q tests/",
    "test:e2e": "node tests/e2e.mjs",
    "measure": "node scripts/measure-memory.mjs"
  },
  "devDependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "esbuild": "0.28.2",
    "puppeteer-core": "^25.17.0",
    "pyodide": "314.0.7"
  }
}
